{
  "version": 2,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/review", "destination": "/api/review" },
    { "source": "/r/:id", "destination": "/api/r/[id]" },
    { "source": "/", "destination": "/api/index" }
  ],
  "env": {
    "CONWAY_API_KEY": "@conway_api_key"
  }
}
